# ------------------------------------------------------------------
# Copier ce fichier en .env.local (dev) ou configurer ces variables
# chez l'hébergeur (Vercel → Settings → Environment Variables).
# NE JAMAIS committer .env.local — les clés restent côté serveur.
# ------------------------------------------------------------------

# --- Envoi d'e-mail du formulaire de contact ---
# Deux transports possibles. Le SMTP est prioritaire s'il est renseigné,
# sinon Resend, sinon le message est seulement journalisé.

# Option A (recommandée) : SMTP Gandi — utilise ta messagerie existante.
SMTP_HOST=mail.gandi.net
SMTP_PORT=465
SMTP_USER=contact@decilapdenis.fr
SMTP_PASSWORD=            # ← mot de passe de la boîte (JAMAIS committé)

# Option B : Resend (API tierce). Créer une clé sur https://resend.com
RESEND_API_KEY=

# Adresse qui reçoit les demandes de contact (par défaut : email du site)
CONTACT_TO_EMAIL=contact@decilapdenis.fr

# Expéditeur. En SMTP, DOIT être la boîte authentifiée (SMTP_USER),
# sinon Gandi rejette l'envoi.
CONTACT_FROM_EMAIL="Portfolio <contact@decilapdenis.fr>"

# --- Analytics sans cookie (Plausible) ---
# Le domaine déclaré dans Plausible (ex. denisdecilap.fr).
# Laisser VIDE désactive l'analytics (aucun script chargé) — pratique en dev.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optionnel : URL du script si auto-hébergé ou proxy.
# Défaut : https://plausible.io/js/script.tagged-events.js
NEXT_PUBLIC_PLAUSIBLE_SRC=
